import json
import os
from datetime import datetime
import streamlit as st

# ==========================================
# 1. MODELOS (Com Encapsulamento / Getters e Setters)
# ==========================================

class Profissional:
    def __init__(self, id: int = 0, nome: str = "", email: str = "", especialidade: str = ""):
        self._id = id
        self._nome = nome
        self._email = email
        self._especialidade = especialidade

    @property
    def id(self) -> int: return self._id
    @id.setter
    def id(self, value: int): self._id = value

    @property
    def nome(self) -> str: return self._nome
    @nome.setter
    def nome(self, value: str): self._nome = value.strip().title()

    @property
    def email(self) -> str: return self._email
    @email.setter
    def email(self, value: str): self._email = value.strip()

    @property
    def especialidade(self) -> str: return self._especialidade
    @especialidade.setter
    def especialidade(self, value: str): self._especialidade = value.strip()

    def to_dict(self) -> dict:
        return {"id": self.id, "nome": self.nome, "email": self.email, "especialidade": self.especialidade}

    @classmethod
    def from_dict(cls, d: dict) -> "Profissional":
        return cls(d["id"], d["nome"], d["email"], d["especialidade"])

class Horario:
    def __init__(self, id: int = 0, data: str = "", confirmado: bool = False, id_cliente: int = 0, id_servico: int = 0, id_profissional: int = 0):
        self._id = id
        self._data = data
        self._confirmado = confirmado
        self._id_cliente = id_cliente
        self._id_servico = id_servico
        self._id_profissional = id_profissional  # Associação com Profissional

    @property
    def id(self) -> int: return self._id
    @id.setter
    def id(self, value: int): self._id = value

    @property
    def data(self) -> str: return self._data
    @data.setter
    def data(self, value: str): self._data = value

    @property
    def confirmado(self) -> bool: return self._confirmado
    @confirmado.setter
    def confirmado(self, value: bool): self._confirmado = value

    @property
    def id_cliente(self) -> int: return self._id_cliente
    @id_cliente.setter
    def id_cliente(self, value: int): self._id_cliente = value

    @property
    def id_servico(self) -> int: return self._id_servico
    @id_servico.setter
    def id_servico(self, value: int): self._id_servico = value

    @property
    def id_profissional(self) -> int: return self._id_profissional
    @id_profissional.setter
    def id_profissional(self, value: int): self._id_profissional = value

    def to_dict(self) -> dict:
        return {
            "id": self.id, "data": self.data, "confirmado": self.confirmado,
            "id_cliente": self.id_cliente, "id_servico": self.id_servico, "id_profissional": self.id_profissional
        }

    @classmethod
    def from_dict(cls, d: dict) -> "Horario":
        return cls(d["id"], d["data"], d["confirmado"], d["id_cliente"], d["id_servico"], d.get("id_profissional", 0))

class Atendimento:
    def __init__(self, id: int = 0, data: str = "", queixa_principal: str = "", historico_saude: str = "", avaliacao: str = "", prescricao: str = "", id_horario: int = 0):
