# Entradas e Formulários
st.text_input("Rótulo")
st.text_area("Rótulo")
with st.form("nome_form"):
    st.form_submit_button("Enviar")

# Layout e Navegação
st.sidebar.radio("Navegação", ["A", "B"])
st.tabs(["Aba 1", "Aba 2"])
st.columns([2, 1])
st.divider()

# Feedback e Estado
st.success("Sucesso")
st.error("Erro")
st.session_state["chave"] = valor
st.rerun()
""",
          language="python",
      )


# ==========================================
# 5. INDEX / MAIN (Session State e Execução)
# ==========================================
def main():
  # COMANDO 16: Configuração Geral da Página (deve ser a primeira instrução Streamlit)
  st.set_page_config(
      page_title="POO - IFRN CNAT", page_icon="⚡", layout="wide"
  )

  # COMANDO 17: Preservação de Estado no Session State
  if "tarefa_dao" not in st.session_state:
    st.session_state.tarefa_dao = TarefaDAO()

  # Injeção de Dependências
  dao = st.session_state.tarefa_dao
  service = TarefaService(dao)
  ui = TarefaUI(service)

  # Renderização do Aplicativo
  ui.renderizar()


if __name__ == "__main__":
  main()




